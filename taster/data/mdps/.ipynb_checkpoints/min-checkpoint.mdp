define                   = -DFLEXIBLE

integrator              =  steep
nsteps                  =  5000

nstcomm                 =  100
comm-grps               =  system

nstlog                  =  0
nstenergy               =  0
nstxout-compressed      =  0

cutoff-scheme            = Verlet
nstlist                  = 20
nsttcouple               = 20
nstpcouple               = 20
rlist                    = 1.35
verlet-buffer-tolerance  = -1
ns_type                  = grid
pbc                      = xyz

coulombtype              = reaction-field 
rcoulomb                 = 1.1
epsilon_r                = 15
epsilon_rf               = 0
vdw_type                 = cutoff  
vdw-modifier             = Potential-shift-verlet
rvdw                     = 1.1

constraints              = none 
constraint_algorithm     = Lincs
lincs_order              = 12
lincs_iter               = 4
lincs_warnangle          = 90
